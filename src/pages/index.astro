---
import Layout from '@/layouts/Layout.astro'
import DrinkList from '@/components/DrinkList.astro'
import Search from '@/components/Search.astro'
import { fetchCraftAPI } from '@/utils/CraftAPI'

// Fetch drinks (limited to 12 for initial load)
const initialLimit = 12
const drinks = await fetchCraftAPI(`/updates/drinks?l=${initialLimit}&s=0`)
---

<Layout title="theAdhopracy">
	<main>
		<h1>Ad Hops</h1>
		<Search />
		<ul role="list" class="h-feed">
			{/* Initial drink list rendered with server-side data */}
			<DrinkList drinks={drinks} server:defer />
			{/* Additional drinks loaded via component fetch calls, which enable HTML streaming */}
			<DrinkList skip={initialLimit} server:defer>
				<li id="loading" slot="fallback">Loading more drinks...</li>
			</DrinkList>
		</ul>
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		font-size: 20px;
		line-height: 1.6;
		background-color: aliceblue;
	}

	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}

	ul {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		max-width: 75rem;
		margin-inline: auto;
		align-content: start;
		align-items: start;
		justify-content: center;
		justify-items: center;
	}

	#loading {
		text-align: center;
		font-size: 1.25rem;
		margin-block: 2rem;
		padding-block-end: 5rem;
	}
</style>
